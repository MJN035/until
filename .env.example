# Until — 환경변수 예시. 실제 비밀키는 절대 커밋하지 말 것(.env는 .gitignore 처리).
# 필요한 줄만 복사해 실제 값으로 채운다. 셸에서 export하거나 저장소 루트 `.env`로
# 두면 내장 최소 로더가 읽는다(이미 설정된 실제 환경변수가 항상 우선한다).

# ── 라이브 LLM 백엔드 (--backend local: OpenAI 호환. Groq 권장/무료) ──
# Groq:   https://console.groq.com  (계정 > API Keys)
UNTIL_BASE_URL=https://api.groq.com/openai/v1
UNTIL_API_KEY=                      # 비밀: Groq/OpenAI 호환 키
UNTIL_MODEL=llama-3.3-70b-versatile # 막히면 llama-3.1-8b-instant(하루 한도 큼)
UNTIL_MAX_TOKENS=2048               # 출력 상한(잘림 방지 시 상향)

# Ollama 로컬을 쓸 경우 예시:
# UNTIL_BASE_URL=http://localhost:11434/v1
# UNTIL_API_KEY=ollama
# UNTIL_MODEL=llama3.1

# ── Anthropic 백엔드 (--backend anthropic: Citations/캐싱/Structured Outputs) ──
# ANTHROPIC_API_KEY=                # 비밀: Anthropic 키

# ── eTL(서울대 Canvas) 접속 ──
# 방법 A) 학생 액세스 토큰 (계정 > 설정 > '+ 새 액세스 토큰')
UNTIL_CANVAS_TOKEN=                 # 비밀: Canvas 액세스 토큰
# 방법 B) 토큰 없이 브라우저 SSO 로그인 → `python -m until.web --sso` (키 불필요)
UNTIL_ETL_BASE=https://myetl.snu.ac.kr

# ── 관리자 보드(선택) ──
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# UNTIL_ADMIN_KEY=                  # 비밀: /admin 로그인 키
# UNTIL_INTERNAL=1                  # 로컬 QA만. 운영에서는 설정하지 않음

# ── 외부 방문 분석(선택, 기본 완전 비활성) ──
# 명시적으로 동의한 브라우저의 공개 소개 화면 PageView만 전송한다.
# UNTIL_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# UNTIL_META_PIXEL_ID=123456789012345

# ── 계정 로그인(선택, 클라우드 모드) ──
# Kakao Developers의 REST API 키/Client Secret과 등록한 Redirect URI.
# UNTIL_KAKAO_CLIENT_ID=
# UNTIL_KAKAO_CLIENT_SECRET=          # 비밀
# UNTIL_KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
# UNTIL_KAKAO_SCOPES=                 # 선택: profile_nickname,account_email
# Google을 함께 또는 대신 사용할 때:
# UNTIL_GOOGLE_CLIENT_ID=
# UNTIL_GOOGLE_CLIENT_SECRET=         # 비밀
# UNTIL_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# UNTIL_REQUIRE_LOGIN=1               # 선택: 작업 전에 로그인 강제

# ── GEPA 프롬프트 최적화(선택) ──
# UNTIL_GEPA_MODEL=groq/llama-3.3-70b-versatile
# UNTIL_GEPA_BUDGET=18
# UNTIL_GEPA_THREADS=1

# ── 빈 결정 칸 자동 채움 ──
# 사용자가 결정 질문에 답하지 않고 '완성하기'를 누르면 AI 제안으로 채운다(기본 켬).
# 채운 사실과 내용은 완성·제출 화면에 그대로 표시된다. 0이면 예전처럼 빈 칸으로 둔다.
# UNTIL_AUTOFILL_DECISIONS=0

# ── Local Agent Runtime(`python -m until.runtime`) ──
# 설정 전문은 docs/LOCAL_AGENT_SETUP.md. CLI 설정과 OS 샌드박스가 둘 다 있어야 열린다.
# UNTIL_AGENT_CMD=<공식 CLI 실행 파일>
# UNTIL_AGENT_RUN_ARGS=<비대화형 실행 플래그>,{prompt}
# UNTIL_AGENT_SPEC=/절대경로/agent.json     # 위 간이 설정보다 우선(examples/agent-spec.example.json)
# UNTIL_AGENT_SANDBOX=<샌드박스 실행 파일>,<인자>,...
# UNTIL_AGENT_SANDBOX_ISOLATES=filesystem,network   # 실제로 막는 것만 신고할 것
